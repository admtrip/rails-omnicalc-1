<h1>Random Number Generator</h1>

<%= form_with url: "/random/result", method: "get" do %>
  <label for="user_min">Minimum</label>
  <input type="text" name="min" id="user_min">

  <label for="user_max">Maximum</label>
  <input type="text" name="max" id="user_max">

  <button type="submit">Pick random number</button>
<% end %>
